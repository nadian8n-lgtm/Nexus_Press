rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ضع هنا UID حساب الأدمن (Authentication > Users > User UID)
    function isAdmin() {
      return request.auth != null && request.auth.uid == 'PUT_ADMIN_UID_HERE';
    }

    match /messages/{id} {
      // أي زائر يستطيع إرسال رسالة بالشكل المحدد فقط
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'status', 'reply', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 150
        && request.resource.data.subject is string
        && request.resource.data.subject.size() >= 2 && request.resource.data.subject.size() <= 150
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10 && request.resource.data.message.size() <= 3000
        && request.resource.data.status == 'new'
        && request.resource.data.reply == ''
        && request.resource.data.createdAt == request.time;

      // الزائر يقرأ رسالته فقط إذا كان يعرف رمزها (20 حرفاً عشوائياً)
      allow get: if true;

      // قائمة الرسائل والرد والحذف للأدمن فقط
      allow list, update, delete: if isAdmin();
    }
  }
}
